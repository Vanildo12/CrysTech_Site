# GEMINI_API_KEY: used server-side only (api/chat.ts). Never prefix with VITE_
# or reference it from client code — that would bundle it into the public build.
GEMINI_API_KEY=your_gemini_api_key_here

# RESEND_API_KEY: used server-side only (api/contact.ts) to send the contact
# form emails via https://resend.com. Never prefix with VITE_.
RESEND_API_KEY=your_resend_api_key_here

# Google Analytics Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
